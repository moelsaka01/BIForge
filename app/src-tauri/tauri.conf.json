{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIForge",
  "version": "0.0.1",
  "identifier": "org.biforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BIForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BIForge contributors",
    "copyright": "Copyright 2026 BIForge contributors. Licensed under the Apache License 2.0.",
    "category": "Productivity",
    "shortDescription": "Open-source desktop app for building business intelligence reports",
    "longDescription": "BIForge builds data models and reports on your own computer. It opens and saves PBIP/TMDL projects, shares reports through folders, your own cloud storage, direct connections or a server you host, and never needs a cloud account of its own.",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "biforge"
        ],
        "name": "BIForge shared report",
        "description": "BIForge shared report package",
        "role": "Viewer",
        "mimeType": "application/vnd.biforge.package"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "biforge"
        ]
      }
    }
  }
}
