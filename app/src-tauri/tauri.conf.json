{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIForge",
  "version": "0.0.1",
  "identifier": "org.biforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BIForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
